# Font
font_family      IosevkaTerm Nerd Font Medium
font_size        15.0
bold_font        auto
italic_font      auto
bold_italic_font auto

# Cursor
cursor_shape underline
cursor_blink_interval 0

# Window
initial_window_width  80c
initial_window_height 25c
background_opacity    1.0
remember_window_size  yes
window_padding_width  4

# Scrollback
scrollback_lines 1000

# Terminal
term xterm-256color
shell_integration enabled

# Bell
enable_audio_bell no
visual_bell_duration 0.1

# Mouse
mouse_hide_wait 3.0

# macOS specific
macos_option_as_alt yes
macos_titlebar_color background
hide_window_decorations titlebar-only
macos_quit_when_last_window_closed yes

# Tab bar
tab_bar_style powerline
tab_bar_min_tabs 2

# Graphics protocol (for image.nvim / molten)
allow_remote_control yes
listen_on unix:/tmp/kitty

# ── One Dark Color Scheme ──

# Primary
foreground #abb2bf
background #282828

# Cursor
cursor #abb2bf

# Selection
selection_foreground none
selection_background #323844

# ANSI Black
color0  #21252b
color8  #767676

# ANSI Red
color1  #e06c75
color9  #e06c75

# ANSI Green
color2  #98c379
color10 #98c379

# ANSI Yellow
color3  #e5c07b
color11 #e5c07b

# ANSI Blue
color4  #61afef
color12 #61afef

# ANSI Magenta
color5  #c678dd
color13 #c678dd

# ANSI Cyan
color6  #56b6c2
color14 #56b6c2

# ANSI White
color7  #abb2bf
color15 #abb2bf
